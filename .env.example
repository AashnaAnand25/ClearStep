# Optional. Without a key, clearly labelled sample explanations remain available.
# Copy this file to .env and set the key locally. Never commit .env.

# Choose AI provider: "gemini" (free tier), "openai" (paid), or "ollama" (local)
AI_PROVIDER=gemini

# Gemini API (Google - has free tier): Get key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# OpenAI API (paid): Get key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Form companion: local Ollama by default. Set openai or gemini on a hosted server.
# For hosted extensions: comma-separated IDs shown in extension settings.
CLEARSTEP_EXTENSION_IDS=
